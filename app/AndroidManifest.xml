<?xml version="1.0" encoding="utf-8"?>
<!--
    The package name keeps its original "stremiovoice" spelling on purpose: changing it
    would make sticks that already have the add-on install a second copy instead of updating.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.metaljay.stremiovoice"
    android:versionCode="11"
    android:versionName="2.7">

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="29" />

    <uses-permission android:name="com.amazon.vizzini.SPEECH_RECOGNIZER" />
    <!-- Opens Amazon's own search results screen. Platform "signature|privileged": the add-on's
         system whitelist (privapp-permissions-...xml) must list it too, or the stick won't boot. -->
    <uses-permission android:name="com.amazon.tv.launcher.permission.SHOW_SEARCH_RESULTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The pick-list looks titles up in the catalogue. An ordinary permission, granted at install. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Voice Search"
        android:icon="@drawable/ic_voice"
        android:banner="@drawable/banner"
        android:allowBackup="false">

        <service
            android:name=".VoiceService"
            android:exported="false" />

        <!-- The TiviMate helper: an accessibility service limited to TiviMate (see
             res/xml/tivimate_helper.xml). Needs no extra permission. The add-on's script
             switches it on only while TiviMate is the chosen app. -->
        <service
            android:name=".TiviMateHelper"
            android:exported="true"
            android:label="@string/tivimate_helper_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tivimate_helper" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The Voice Search settings screen: choose the app to search in. Opened from the
             Voice Search tile app or by voice. No launcher entry of its own: Amazon's home
             screen hides system apps anyway, and home screens that show them would list
             Voice Search twice (once for this app, once for the tile). -->
        <activity
            android:name=".ChooserActivity"
            android:exported="true"
            android:label="Voice Search"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- The Updates screen: opened from the settings screen or the update notification. -->
        <activity
            android:name=".UpdatesActivity"
            android:exported="false"
            android:label="Voice Search updates"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- "Support Voice Search": a QR code for the Buy Me a Coffee page. Nothing is sent. -->
        <activity
            android:name=".SupportActivity"
            android:exported="false"
            android:label="Support Voice Search"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- "Send a problem report": opened from the settings screen. -->
        <activity
            android:name=".ReportActivity"
            android:exported="false"
            android:label="Send a problem report"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:windowSoftInputMode="adjustResize" />

        <!-- The scheduled update check (about every six hours, only with a network). -->
        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The pick-list, opened only by the service. -->
        <activity
            android:name=".ResultsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.metaljay.stremiovoice.results"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

    </application>
</manifest>
