<?xml version="1.0" encoding="utf-8"?>
<!--
    The Voice Search setup app: an ordinary app (so an app store can list it) that
    puts a "Voice Search" tile on Amazon's home screen, which hides system apps such
    as the main app. With the add-on running, opening it opens the main app's
    settings screen. Without it, it opens the setup screens, which install the
    Magisk add-on (after warnings, and Magisk's own permission prompt).
    The add-on also installs it at boot if it is missing or older (module/service.sh).
    INTERNET is its only permission: it downloads the add-on from GitHub.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.metaljay.voicesearchtile"
    android:versionCode="2"
    android:versionName="2.7">

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="29" />

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Voice Search"
        android:icon="@drawable/ic_voice"
        android:banner="@drawable/banner"
        android:allowBackup="false">

        <activity
            android:name=".TileActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar" />

    </application>
</manifest>
